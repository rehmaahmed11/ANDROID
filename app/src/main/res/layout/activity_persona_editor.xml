<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="New profile"
            android:textColor="@color/ink"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/name_label"
            style="@style/SectionTitle" />

        <EditText
            android:id="@+id/nameField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. Rehma, Work, Family"
            android:importantForAutofill="no"
            android:inputType="textPersonName"
            android:maxLength="40" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/tagline_label"
            style="@style/SectionTitle" />

        <EditText
            android:id="@+id/taglineField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="one line, shown under the name"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLength="60" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/colour_label"
            style="@style/SectionTitle" />

        <LinearLayout
            android:id="@+id/swatches"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/pin_label"
            style="@style/SectionTitle" />

        <EditText
            android:id="@+id/pinField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="leave empty to keep the current setting"
            android:importantForAutofill="no"
            android:inputType="textPassword"
            android:maxLength="64" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="With a PIN, the profile's data is encrypted with a key derived from that PIN and never stored. Forget it and the data is unrecoverable - that is the point."
            style="@style/Body"
            android:textColor="@color/ink_soft" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/auto_lock_label"
            style="@style/SectionTitle" />

        <EditText
            android:id="@+id/autoLockField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="5"
            android:text="60" />

        <Button
            android:id="@+id/saveButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/save" />

        <Button
            android:id="@+id/deleteButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/delete"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
