<?xml version="1.0" encoding="utf-8"?>
<!-- Solid tinted tile + white head-and-shoulders, so a pinned persona icon looks like an app
     on launchers that refuse to wrap shortcut icons in their own background. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/accent" />
            <size android:width="108dp" android:height="108dp" />
        </shape>
    </item>
    <item android:drawable="@drawable/ic_persona" android:gravity="center" />
</layer-list>
